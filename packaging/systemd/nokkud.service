[Unit]
Description=Nokku Daemon
Documentation=https://github.com/nokku-sh/nokkud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nokkud
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening (safe subset). Sessions run arbitrary user commands and the daemon
# needs the TPM device, so these are deliberately left unset: ProtectSystem,
# ProtectHome, PrivateDevices, PrivateTmp (sessions must write wherever the
# target user can, and the TPM device must be reachable), NoNewPrivileges (a
# root session must be able to run setuid tools such as sudo), and
# CapabilityBoundingSet (tuning it requires exercising every session path).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
SystemCallArchitectures=native
RestrictRealtime=yes
TasksMax=8192

[Install]
WantedBy=multi-user.target
