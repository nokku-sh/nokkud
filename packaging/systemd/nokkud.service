[Unit]
Description=Nokku Daemon
Documentation=https://github.com/nokku-sh/nokkud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nokkud
Restart=on-failure
# 78 means not enrolled, restarting cannot fix that.
RestartPreventExitStatus=78
RestartSec=5s
# Like sshd.service: a restart or upgrade only replaces the daemon, the
# sessions it spawned keep running.
KillMode=process
LimitNOFILE=65536

# No sandboxing. Sessions are children of the daemon and inherit every
# restriction set here, so a root shell could not load modules, set sysctls,
# capture packets, or change the clock. Sessions are isolated by the target
# user's own privileges, like OpenSSH.

[Install]
WantedBy=multi-user.target
