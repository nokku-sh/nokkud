policy_module(nokkud, 1.1.0)

type nokkud_t;
type nokkud_exec_t;
init_daemon_domain(nokkud_t, nokkud_exec_t)

type nokkud_var_lib_t;
files_type(nokkud_var_lib_t)

# nokkud is a session daemon like sshd: sessions are its children and run in
# its domain, so a confined domain would confine every user shell with it.
# The POSIX user boundary isolates sessions, matching the AppArmor profile.
unconfined_domain(nokkud_t)
